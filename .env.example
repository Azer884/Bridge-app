RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=
RUNPOD_VISION_ENDPOINT_ID=
# Front door (src/server.py). Choose your own random values; never commit them.
INCOMING_API_KEY=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
RUNPOD_VISION_API_KEY=
# Voice notes: RunPod faster-whisper worker. Leave the endpoint empty to transcribe on the server CPU.
STT_RUNPOD_ENDPOINT_ID=
STT_RUNPOD_API_KEY=
STT_RUNPOD_MODEL=small
# ElevenLabs API Key
# Sign up / get key at https://elevenlabs.io
ELEVENLABS_API_KEY=
# WhatsApp calls (see voice_worker/README.md). Calls use the same /webhook; keep disabled until the worker runs.
WHATSAPP_CALLING_ENABLED=false
WHATSAPP_CALL_GRAPH_API_VERSION=26.0
WHATSAPP_LIVEKIT_AGENT_NAME=orbyte-whatsapp
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# The voice worker (a separate process): where the assistant lives, and the voice it speaks with
VOICE_BACKEND_URL=https://gesir-ai.replit.app
VOICE_TTS_VOICE=

# Orbyte hub link (optional): signed events to a hub, and roles passed in by it. See docs/ORBYTE.md
ORBYTE_WEBHOOK_URL=
ORBYTE_SHARED_SECRET=
ORBYTE_ORIGIN=
# AI_INTENTS=0 turns off the model reading what a message means (withdrawal, cancel, restart); on by default
