modules = ["python-3.12"]
run = "python -m uvicorn src.server:create_app --factory --host 0.0.0.0 --port 8000"

[nix]
channel = "stable-24_05"

[agent]
expertMode = true

[userenv]

[userenv.shared]
PIP_TARGET = ".pythonlibs/lib/python3.12/site-packages"
PIP_USER = "false"

[deployment]
run = ["sh", "-c", "python -m uvicorn src.server:create_app --factory --host 0.0.0.0 --port 8000"]
deploymentTarget = "vm"
ignorePorts = false
build = ["sh", "-c", "python -m pip install --no-user --upgrade --target .pythonlibs/lib/python3.12/site-packages -r requirements.txt"]

[[ports]]
localPort = 8000
externalPort = 80

[packager.features]
enabledForHosting = false

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Backend API"

[[workflows.workflow]]
name = "Backend API"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python -m uvicorn src.server:create_app --factory --host 0.0.0.0 --port 8000"
waitForPort = 8000

[workflows.workflow.metadata]
outputType = "console"
