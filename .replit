modules = ["python-3.12", "nodejs-20", "web"]
run = "PORT=8000 python scripts/mock_orbyte.py"

[nix]
channel = "stable-25_05"

[agent]
expertMode = true

[userenv]

[userenv.shared]

[deployment]
run = ["sh", "-c", "PORT=8000 python scripts/mock_orbyte.py"]
deploymentTarget = "vm"
ignorePorts = false

[[ports]]
localPort = 8000
externalPort = 80

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Backend API"

[[workflows.workflow]]
name = "Backend API"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=8000 python scripts/mock_orbyte.py"
waitForPort = 8000

[workflows.workflow.metadata]
outputType = "console"
