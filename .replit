modules = ["python-3.12", "nodejs-20", "web"]
run = "python -m uvicorn src.server:create_app --factory --host 0.0.0.0 --port 8000"

[nix]
channel = "stable-25_05"

[agent]
expertMode = true

[userenv]

[userenv.shared]

[deployment]
run = ["sh", "-c", "python -m uvicorn src.server:create_app --factory --host 0.0.0.0 --port 8000"]
deploymentTarget = "vm"
ignorePorts = false

[[ports]]
localPort = 8000
externalPort = 80

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Backend API"

[[workflows.workflow]]
name = "Backend API"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python -m uvicorn src.server:create_app --factory --host 0.0.0.0 --port 8000"
waitForPort = 8000

[workflows.workflow.metadata]
outputType = "console"
