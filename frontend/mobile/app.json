{
  "expo": {
    "name": "Gesir",
    "slug": "gesir-dashboard",
    "version": "0.1.0",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#041B2D"
    },
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#EAF1F1",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "my.gesir.dashboard"
    },
    "android": {
      "package": "my.gesir.dashboard",
      "backgroundColor": "#EAF1F1",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#041B2D"
      },
      "permissions": [
        "POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      "expo-font",
      [
        "expo-notifications",
        {
          "color": "#041B2D"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "795d0187-d840-47e9-9bbb-c6b70cf14649"
      }
    },
    "owner": "weldhama"
  }
}
