# Copy to .env (gitignored). Leave VITE_USE_MOCK=true until the backend is linked.
VITE_USE_MOCK=true

# Server-side only (used by the Vite proxy, never shipped to the browser)
API_URL=https://Gesir-AI.replit.app
API_KEY=

# Google OAuth client id (Web application) with the Calendar API enabled. Leave empty for demo mode.
VITE_GOOGLE_CLIENT_ID=

# Set to true once GET /api/bookings exists on the backend
VITE_BOOKINGS_LIVE=false

